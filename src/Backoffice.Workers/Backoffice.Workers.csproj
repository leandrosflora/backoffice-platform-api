<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Backoffice.Workers-821ba17c-aba7-448c-8e2e-21862d4fc3e9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for WebApplication/Kestrel (the process's sole liveness-probe endpoint) even
         though this stays a Worker SDK project, not a Web SDK one. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.15.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Backoffice.Application\Backoffice.Application.csproj" />
    <ProjectReference Include="..\Backoffice.Infrastructure\Backoffice.Infrastructure.csproj" />
    <ProjectReference Include="..\Backoffice.Domain\Backoffice.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Backoffice.Workers.Tests" />
  </ItemGroup>
</Project>
