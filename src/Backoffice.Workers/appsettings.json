{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Backoffice": "Host=localhost;Port=5432;Database=backoffice;Username=backoffice;Password=backoffice"
  },
  "Opa": {
    "BaseUrl": "http://localhost:8181"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "EventsTopic": "backoffice.events.v1",
    "DlqTopic": "backoffice.dlq.v1",
    "ConsumerGroup": "backoffice-workflow-v1"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "DocumentIntelligence": {
    "BaseUrl": "http://localhost:8090"
  },
  "DocumentStorage": {
    "RootPath": ".local/document-storage",
    "MaxUploadBytes": 10485760
  },
  "DocumentProcessing": {
    "Inline": false
  },
  "MalwareScan": {
    "Mode": "clamav",
    "ClamAv": {
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  }
}
