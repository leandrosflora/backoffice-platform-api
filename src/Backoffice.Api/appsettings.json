{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Backoffice": "Host=localhost;Port=5432;Database=backoffice;Username=backoffice;Password=backoffice"
  },
  "Opa": {
    "BaseUrl": "http://localhost:8181"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "DocumentStorage": {
    "RootPath": ".local/document-storage",
    "MaxUploadBytes": 10485760
  },
  "DocumentProcessing": {
    "Inline": false
  },
  "MalwareScan": {
    "Mode": "clamav",
    "ClamAv": {
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "Identity": {
    "Mode": "headers",
    "PublicKeyPath": ".local/security/identity-public.pem",
    "Issuer": "https://identity.local",
    "Audience": "intelligent-backoffice-api",
    "MaxTtlSeconds": 300
  }
}
